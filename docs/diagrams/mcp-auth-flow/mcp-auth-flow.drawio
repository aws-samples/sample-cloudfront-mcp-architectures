        <mxCell id="e-4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=0.5;exitY=0;entryX=0.5;entryY=0;fontFamily=Helvetica;" edge="1" parent="1" source="svc-cff" target="actor-client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="220" /><mxPoint x="100" y="220" /></Array></mxGeometry></mxCell>
        <mxCell id="e-4-label" value="401 WWW-Authenticate: Bearer resource_metadata=..." style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontColor=#545B64;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-4"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="-14" as="offset" /></mxGeometry></mxCell>
        <mxCell id="step-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="1" vertex="1" parent="1"><mxGeometry x="130" y="196" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="e-5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=horizontal;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;" edge="1" parent="1" source="svc-cff" target="svc-origin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-5-label" value="x-jwt-claims, x-forwarded-host" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontColor=#545B64;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-5"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="28" as="offset" /></mxGeometry></mxCell>
        <mxCell id="step-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="2" vertex="1" parent="1"><mxGeometry x="666" y="308" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="e-6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=1;fontFamily=Helvetica;" edge="1" parent="1" source="actor-client" target="svc-cognito"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="560" /><mxPoint x="1140" y="560" /></Array></mxGeometry></mxCell>
        <mxCell id="e-6-label" value="client credentials, scope=mcp/&amp;lt;pattern&amp;gt;  →  access token" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontColor=#545B64;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-6"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="14" as="offset" /></mxGeometry></mxCell>
        <mxCell id="step-3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="3" vertex="1" parent="1"><mxGeometry x="600" y="536" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="e-7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=horizontal;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;" edge="1" parent="1" source="svc-origin" target="svc-cognito"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-7-label" value="JWKS" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontColor=#545B64;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-7"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="28" as="offset" /></mxGeometry></mxCell>
        <mxCell id="step-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="4" vertex="1" parent="1"><mxGeometry x="966" y="308" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="legend-bg" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" value="" vertex="1" parent="1"><mxGeometry x="1320" y="30" width="620" height="490" as="geometry" /></mxCell>
        <mxCell id="legend-container" connectable="0" style="group" value="" vertex="1" parent="1"><mxGeometry x="1340" y="55" width="580" height="450" as="geometry" /></mxCell>
        <mxCell id="step-1-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="128" width="580" x="0" y="0" as="geometry" /></mxCell>
        <mxCell id="step-1-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1" parent="step-1-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="step-1-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Discovery: 401 from the edge&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A request without a usable token gets 401 with WWW-Authenticate: Bearer resource_metadata=&quot;https://&amp;lt;distribution&amp;gt;/.well-known/oauth-protected-resource/mcp&quot; from the CloudFront Function, after the web ACL. The origin serves that RFC 9728 document (cached by CloudFront); on pattern 1 the function answers it.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-1-legend"><mxGeometry height="128" width="528" x="52" as="geometry" /></mxCell>
        <mxCell id="step-2-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="110" width="580" x="0" y="128" as="geometry" /></mxCell>
        <mxCell id="step-2-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="step-2-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="step-2-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Edge pre-filter&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The function decodes the JWT and refuses a missing, malformed, expired, wrong-issuer or non-access token at the edge. It does not check the signature (CloudFront Functions have no RSA verify), so it replaces any client-sent x-jwt-claims with the decoded payload for the regional WAF.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-2-legend"><mxGeometry height="110" width="528" x="52" as="geometry" /></mxCell>
        <mxCell id="step-3-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="92" width="580" x="0" y="238" as="geometry" /></mxCell>
        <mxCell id="step-3-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="step-3-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="step-3-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Token from Cognito&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The client follows the metadata to the issuer and requests a client-credentials token with the pattern’s scope. Scopes stand in for an audience: a token for one pattern is refused by the others.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-3-legend"><mxGeometry height="92" width="528" x="52" as="geometry" /></mxCell>
        <mxCell id="step-4-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="110" width="580" x="0" y="330" as="geometry" /></mxCell>
        <mxCell id="step-4-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="step-4-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="step-4-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Verified at the origin&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Each origin checks the RS256 signature against the Cognito JWKS and requires its own scope: the AgentCore Gateway authorizer, the API Gateway Cognito authorizer, or the hello server itself (web function, ALB). A tampered payload passes the edge and fails here.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-4-legend"><mxGeometry height="110" width="528" x="52" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
