        <mxCell id="step-6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="6" vertex="1" parent="1"><mxGeometry x="1086" y="308" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="e-12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=horizontal;startArrow=none;endFill=1;strokeColor=#DD344C;dashed=1;rounded=0;exitX=1;exitY=0.5;entryX=0.25;entryY=1;fontFamily=Helvetica;" edge="1" parent="1" source="svc-owaf" target="svc-apigw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-12-label" value="associated with the stage" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontColor=#DD344C;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-12"><mxGeometry relative="1" x="-0.3" y="0" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="e-13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=horizontal;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;" edge="1" parent="1" source="svc-apigw" target="svc-lambda"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-13-label" value="token valid" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontColor=#545B64;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-13"><mxGeometry relative="1" x="0" y="0" as="geometry"><mxPoint x="0" y="28" as="offset" /></mxGeometry></mxCell>
        <mxCell id="step-7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="7" vertex="1" parent="1"><mxGeometry x="1316" y="308" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="e-14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;elbow=vertical;startArrow=none;endFill=1;strokeColor=#545B64;rounded=0;exitX=0.75;exitY=1;entryX=0;entryY=0.5;fontFamily=Helvetica;" edge="1" parent="1" source="svc-apigw" target="svc-cognito"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-14-label" value="verifies token, scope" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontColor=#545B64;fontFamily=Helvetica;" connectable="0" vertex="1" parent="e-14"><mxGeometry relative="1" x="0.3" y="0" as="geometry"><mxPoint x="0" y="14" as="offset" /></mxGeometry></mxCell>
        <mxCell id="legend-bg" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" value="" vertex="1" parent="1"><mxGeometry x="1740" y="30" width="620" height="658" as="geometry" /></mxCell>
        <mxCell id="legend-container" connectable="0" style="group" value="" vertex="1" parent="1"><mxGeometry x="1760" y="55" width="580" height="618" as="geometry" /></mxCell>
        <mxCell id="step-1-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="92" width="580" x="0" y="0" as="geometry" /></mxCell>
        <mxCell id="step-1-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1" parent="step-1-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="step-1-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;AWS WAF at the edge&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The CloudFront-scope web ACL stops floods, bad bots, oversized bodies, unapproved tools and injection in tool arguments before a request can cost a Lambda invocation.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-1-legend"><mxGeometry height="92" width="528" x="52" as="geometry" /></mxCell>
        <mxCell id="step-2-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="74" width="580" x="0" y="92" as="geometry" /></mxCell>
        <mxCell id="step-2-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="step-2-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="step-2-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;CloudFront distribution&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A public entry point for an API that is otherwise reachable only from inside the VPC. /mcp is not cached.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-2-legend"><mxGeometry height="74" width="528" x="52" as="geometry" /></mxCell>
        <mxCell id="step-3-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="74" width="580" x="0" y="166" as="geometry" /></mxCell>
        <mxCell id="step-3-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="step-3-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="step-3-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;CloudFront Function (viewer request)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Token pre-filter with 401 and resource_metadata, x-jwt-claims and x-forwarded-host for the origin.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-3-legend"><mxGeometry height="74" width="528" x="52" as="geometry" /></mxCell>
        <mxCell id="step-4-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="92" width="580" x="0" y="240" as="geometry" /></mxCell>
        <mxCell id="step-4-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="step-4-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="step-4-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;VPC origin to an internal NLB&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The NLB has only private IPs; its security group admits 443 from the CloudFront origin-facing prefix list. It passes TCP through, so TLS runs end to end from CloudFront to the endpoint.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-4-legend"><mxGeometry height="92" width="528" x="52" as="geometry" /></mxCell>
        <mxCell id="step-5-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="92" width="580" x="0" y="332" as="geometry" /></mxCell>
        <mxCell id="step-5-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="step-5-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="step-5-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;execute-api VPC endpoint&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The NLB targets the endpoint’s network interface IPs. The REST API is private: its resource policy allows execute-api:Invoke only through this endpoint, and the public hostname answers 403.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-5-legend"><mxGeometry height="92" width="528" x="52" as="geometry" /></mxCell>
        <mxCell id="step-6-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="92" width="580" x="0" y="424" as="geometry" /></mxCell>
        <mxCell id="step-6-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="step-6-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="step-6-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Regional AWS WAF and Cognito authorizer on the stage&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;OriginWaf requires the secret header and an mcp/ scope; the Cognito authorizer on every method verifies the token signature and the mcp/api-gateway scope. A bad token never reaches Lambda.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-6-legend"><mxGeometry height="92" width="528" x="52" as="geometry" /></mxCell>
        <mxCell id="step-7-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="92" width="580" x="0" y="516" as="geometry" /></mxCell>
        <mxCell id="step-7-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1" parent="step-7-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
        <mxCell id="step-7-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Lambda runs the hello image&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The same arm64 container as the other patterns, through Lambda Web Adapter. REST APIs buffer responses and time out at 29 s, so the server answers JSON rather than a long SSE stream.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-7-legend"><mxGeometry height="92" width="528" x="52" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
